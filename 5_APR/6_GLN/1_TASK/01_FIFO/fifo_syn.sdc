set sdc_version 2.0

set_units -capacitance 1000fF
set_units -time 1000ps

# Set the current design
current_design fifo

create_clock -name "clk" -period 10.0 -waveform {0.0 5.0} [get_ports i_clk]
set_clock_transition 0.1 [get_clocks clk]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks clk] -add_delay -max 1.0 [get_ports i_rst_n]
set_input_delay -clock [get_clocks clk] -add_delay -max 1.0 [get_ports i_wr_en]
